{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src"],
        // Preview wiring is presentation-layer plumbing — the rendering itself
        // is exercised end-to-end in PreviewRendererTest, but mutation testing
        // adds no value over the integration coverage.
        "excludes": [
            "PreviewRenderer.php",
            "PreviewCommand.php",
            "CommandProvider.php",
        ],
    },
    "logs": {
        "text": "infection.log",
    },
    "tmpDir": ".infection",
    "phpUnit": {
        "configDir": ".",
    },
    "minMsi": 100,
    "minCoveredMsi": 100,
    "mutators": {
        "@default": true,
        // Removing the first hex stop from each preset's palette is observable but
        // pinning every preset to a hardcoded RGB triple would just duplicate the
        // enum data — the readability/coverage trade-off is bad.
        "ArrayItemRemoval": {
            "ignore": [
                "Wazum\\ComposerFanfare\\Preset::colors",
            ],
        },
        // random_int bounds are inherently non-deterministic to test without
        // injecting an RNG seam. The bounds are correct by construction.
        // The first loop iteration always overwrites $bestIndex regardless of its
        // initial value (any distance < PHP_INT_MAX), so swapping 0 → -1 is
        // observationally equivalent.
        "DecrementInteger": {
            "ignore": [
                "Wazum\\ComposerFanfare\\Plugin::resolveColors",
                "Wazum\\ComposerFanfare\\Renderer::render",
                "Wazum\\ComposerFanfare\\Renderer::buildStyledLines",
                "Wazum\\ComposerFanfare\\Renderer::maxLineWidth",
                "Wazum\\ComposerFanfare\\ColorSupport::quantizeChannel",
                "Wazum\\ComposerFanfare\\ColorSupport::rgbToBasicIndex",
                // 0x80–0xBF as a *char start* is malformed UTF-8; the
                // defensive arm returns 1, observable only with crafted
                // garbage input.
                "Wazum\\ComposerFanfare\\TypewriterAnimation::utf8CharLength",
                // delayMicros(0) returns 0, but for an empty banner no sleep
                // is ever issued — the value is unreachable from the public
                // API regardless of what 0 mutates to.
                "Wazum\\ComposerFanfare\\TypewriterAnimation::delayMicros",
            ],
        },
        "IncrementInteger": {
            "ignore": [
                "Wazum\\ComposerFanfare\\Plugin::resolveColors",
                "Wazum\\ComposerFanfare\\TemplateLoader::isAbsolutePath",
                "Wazum\\ComposerFanfare\\Renderer::render",
                "Wazum\\ComposerFanfare\\Renderer::buildStyledLines",
                "Wazum\\ComposerFanfare\\Renderer::hexToRgb",
                // Same reasoning as DecrementInteger above.
                "Wazum\\ComposerFanfare\\TypewriterAnimation::utf8CharLength",
                "Wazum\\ComposerFanfare\\TypewriterAnimation::delayMicros",
            ],
        },
        "Minus": {
            "ignore": [
                "Wazum\\ComposerFanfare\\Plugin::resolveColors",
                "Wazum\\ComposerFanfare\\Renderer::lerpRgb",
            ],
        },
        // realpath / filesize / file_get_contents only return false in pathological
        // FS conditions that aren't reproducible in the test environment.
        "FalseValue": {
            "ignore": [
                "Wazum\\ComposerFanfare\\TemplateLoader::loadContents",
                "Wazum\\ComposerFanfare\\TemplateLoader::rootDir",
                "Wazum\\ComposerFanfare\\TemplateLoader::isAbsolutePath",
            ],
        },
        "Ternary": {
            "ignore": ["Wazum\\ComposerFanfare\\TemplateLoader::rootDir"],
        },
        // Removing one DIRECTORY_SEPARATOR side from str_starts_with($real.SEP, $rootReal.SEP)
        // changes observable behavior only when $real == $rootReal exactly, which can't
        // reach this code (caught earlier by is_file).
        "ConcatOperandRemoval": {
            "ignore": ["Wazum\\ComposerFanfare\\TemplateLoader::loadContents"],
        },
        // (int) casts on round() / hexdec() are defensive — sprintf '%d' coerces
        // floats to int representation identically.
        "CastInt": {
            "ignore": [
                "Wazum\\ComposerFanfare\\Renderer::sampleGradient",
                "Wazum\\ComposerFanfare\\Renderer::lerpRgb",
                "Wazum\\ComposerFanfare\\Renderer::hexToRgb",
                "Wazum\\ComposerFanfare\\ColorSupport::rgbToCubeIndex",
            ],
        },
        // round vs ceil produce identical results for half-integer fractions used
        // by our gradient interpolation; not a meaningful bug surface.
        "RoundingFamily": {
            "ignore": ["Wazum\\ComposerFanfare\\Renderer::lerpRgb"],
        },
        // Plugin's WINDOWS_PATH preg_match runs only on Windows-style absolute paths;
        // not testable from a Linux CI runner without elaborate mocking.
        "MethodCallRemoval": {
            "ignore": ["Wazum\\ComposerFanfare\\TemplateLoader::loadContents"],
        },
        // The first/second match arms in TypewriterAnimation::utf8CharLength both return 1.
        // Removing either leaves the other catching the same input range with
        // the same value — observationally equivalent.
        "MatchArmRemoval": {
            "ignore": ["Wazum\\ComposerFanfare\\TypewriterAnimation::utf8CharLength"],
        },
        // ASCII (< 0x80) and continuation bytes (0x80–0xBF) both resolve to a
        // 1-byte chunk, so flipping the < to <= at those boundaries is
        // observationally equivalent for valid UTF-8 input.
        "LessThan": {
            "ignore": ["Wazum\\ComposerFanfare\\TypewriterAnimation::utf8CharLength"],
        },
        // mb_strlen >= max vs > max in maxLineWidth/colorizeDiagonal: observable
        // only when two lines have the same width and we'd repeat the same value;
        // output is identical. sleep() is a pure timing primitive — no byte
        // output, so its branch condition can't be killed via output assertions
        // without making tests timing-dependent.
        "GreaterThan": {
            "ignore": [
                "Wazum\\ComposerFanfare\\Renderer::maxLineWidth",
                "Wazum\\ComposerFanfare\\Renderer::colorizeDiagonal",
                "Wazum\\ComposerFanfare\\IoAnimationDriver::sleep",
            ],
        },
        "GreaterThanNegotiation": {
            "ignore": ["Wazum\\ComposerFanfare\\IoAnimationDriver::sleep"],
        },
        "FunctionCallRemoval": {
            "ignore": ["Wazum\\ComposerFanfare\\IoAnimationDriver::sleep"],
        },
        // Animation and static paths produce identical buffered byte sequences
        // (the animator just chunks the same writes), so flipping the routing
        // condition or the canAnimate() conjunction can't be detected via the
        // BufferIO-captured output.
        "NotIdentical": {
            "ignore": [
                "Wazum\\ComposerFanfare\\TemplateLoader::rootDir",
                "Wazum\\ComposerFanfare\\Renderer::render",
            ],
        },
        "LogicalAnd": {
            "ignore": [
                "Wazum\\ComposerFanfare\\Renderer::render",
                "Wazum\\ComposerFanfare\\Renderer::canAnimate",
            ],
        },
        "LogicalAndAllSubExprNegation": {
            "ignore": ["Wazum\\ComposerFanfare\\Renderer::canAnimate"],
        },
        "LogicalAndNegation": {
            "ignore": ["Wazum\\ComposerFanfare\\Renderer::canAnimate"],
        },
        "LogicalAndSingleSubExprNegation": {
            "ignore": [
                "Wazum\\ComposerFanfare\\Renderer::render",
                "Wazum\\ComposerFanfare\\Renderer::canAnimate",
            ],
        },
    },
}
