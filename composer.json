{
    "name": "wazum/composer-fanfare",
    "description": "Display a colored ASCII banner after composer install/update.",
    "type": "composer-plugin",
    "license": "MIT",
    "keywords": ["composer-plugin", "banner", "ascii", "ansi", "cli", "fanfare"],
    "authors": [
        {
            "name": "Wolfgang Klinger",
            "email": "wk@plan2.net"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-mbstring": "*",
        "composer-plugin-api": "^2.0"
    },
    "require-dev": {
        "composer/composer": "^2.6",
        "phpstan/phpstan": "^1.12",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Wazum\\ComposerFanfare\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Wazum\\ComposerFanfare\\Tests\\": "tests/"
        }
    },
    "extra": {
        "class": "Wazum\\ComposerFanfare\\Plugin"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "wazum/composer-fanfare": true
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --no-progress"
    },
    "minimum-stability": "stable"
}
