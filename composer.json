{
    "name": "wazum/composer-fanfare",
    "description": "Display a colored ASCII banner after composer install/update.",
    "license": "MIT",
    "type": "composer-plugin",
    "keywords": [
        "composer-plugin",
        "banner",
        "ascii",
        "ansi",
        "cli",
        "fanfare"
    ],
    "authors": [
        {
            "name": "Wolfgang Klinger",
            "email": "wolfgang@wazum.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-mbstring": "*",
        "composer-plugin-api": "^2.0"
    },
    "require-dev": {
        "composer/composer": "^2.6",
        "ergebnis/composer-normalize": "^2.45",
        "friendsofphp/php-cs-fixer": "^3.65",
        "infection/infection": "^0.29",
        "phpstan/phpstan": "^1.12",
        "phpunit/phpunit": "^11.0"
    },
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "Wazum\\ComposerFanfare\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Wazum\\ComposerFanfare\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "infection/extension-installer": true,
            "wazum/composer-fanfare": true
        },
        "sort-packages": true
    },
    "extra": {
        "class": "Wazum\\ComposerFanfare\\Plugin"
    },
    "scripts": {
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "mutation": "infection --threads=4",
        "stan": "phpstan analyse --no-progress",
        "test": "phpunit"
    }
}
